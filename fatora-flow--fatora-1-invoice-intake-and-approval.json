    },
    {
      "parameters": {
        "jsCode": "const m = $('Route Update').item.json.message;\nconst bin = $input.first().binary.data;\nreturn [{ json: { source: 'telegram', sender: (m.from.username ? '@' + m.from.username : m.from.first_name), chat_id: m.chat.id, file_name: bin.fileName || 'photo.jpg', mime: m.document?.mime_type || bin.mimeType || 'image/jpeg' }, binary: { data: bin } }];"
      },
      "id": "n93",
      "name": "Tag Telegram File",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        464
      ]
    },
    {
      "parameters": {
        "jsCode": "// Send the file itself (PDF or photo) to Gemini as base64, with a strict JSON contract.\nconst out = [];\nfor (const [i, item] of $input.all().entries()) {\n  const buf = await this.helpers.getBinaryDataBuffer(i, 'data');\n  if (buf.length > 15 * 1024 * 1024) throw new Error('VALIDATION: file ' + item.json.file_name + ' is larger than 15 MB');\n  out.push({ json: { ...item.json, b64: buf.toString('base64'),\n    prompt: 'You read Egyptian supplier invoices (Arabic or English). Return JSON only with keys: vendor, vendor_tax_id, invoice_number, invoice_date (YYYY-MM-DD), due_date (YYYY-MM-DD or \"\"), currency (EGP|USD|EUR), items: [{description, quantity, unit_price, line_total}], subtotal, vat, total, readable (true|false). Numbers without separators. If a value is not printed on the document use \"\" — never guess.' } });\n}\nreturn out;"
      },
      "id": "n94",
      "name": "Prepare Extraction",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        912,
        208
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googlePalmApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ contents: [{ parts: [{ text: $json.prompt }].concat($json.b64 ? [{ inline_data: { mime_type: $json.mime, data: $json.b64 } }] : []) }], generationConfig: { responseMimeType: 'application/json', temperature: 0.1 } }) }}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "n95",
      "name": "AI Read Invoice",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        208
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "// The AI reads; code checks. Every rule that fails becomes a readable problem.\nconst src = $('Prepare Extraction').item.json;\nlet d; try { d = JSON.parse(($json.candidates?.[0]?.content?.parts || []).map(p => p.text).join('')); } catch (e) { d = null; }\nconst p = []; const num = v => Number(String(v ?? '').replace(/[^0-9.\\-]/g, ''));\nif (!d || d.readable === false) p.push('document unreadable: send a clearer photo or the original PDF');\nd = d || {};\nconst items = Array.isArray(d.items) ? d.items : [];\nconst sumLines = items.reduce((s, it) => s + num(it.line_total), 0);\nitems.forEach((it, k) => { if (Math.abs(num(it.quantity) * num(it.unit_price) - num(it.line_total)) > 1) p.push('line ' + (k + 1) + ': quantity × price ≠ line total'); });\nconst sub = num(d.subtotal), vat = num(d.vat), total = num(d.total);\nif (!total) p.push('total missing');\nif (items.length && Math.abs(sumLines - sub) > 1) p.push('lines add up to ' + sumLines + ' but subtotal says ' + sub);\nif (sub && Math.abs(sub * 0.14 - vat) > Math.max(1, sub * 0.002)) p.push('VAT ' + vat + ' is not 14% of ' + sub);\nif (sub && Math.abs(sub + vat - total) > 1) p.push('subtotal + VAT ≠ total');\nif (!/^\\d{3}-?\\d{3}-?\\d{3}$/.test(String(d.vendor_tax_id || ''))) p.push('tax registration number missing or not 9 digits');\nif (!d.invoice_number) p.push('invoice number missing');\nconst today = $now.setZone('Africa/Cairo').toFormat('yyyy-MM-dd');\nif (!/^\\d{4}-\\d{2}-\\d{2}$/.test(d.invoice_date || '') || d.invoice_date > today) p.push('invoice date missing or in the future');\nif (d.due_date && d.due_date < today) p.push('due date already passed');\nif (!['EGP', 'USD', 'EUR'].includes(d.currency)) p.push('currency not recognised');\nconst tax = String(d.vendor_tax_id || '').replace(/\\D/g, '').replace(/(\\d{3})(\\d{3})(\\d{3})/, '$1-$2-$3');\nreturn [{ json: { ...src, b64: undefined, vendor: d.vendor || '', vendor_tax_id: tax, invoice_number: String(d.invoice_number || ''), invoice_date: d.invoice_date || '', due_date: d.due_date || '',\n  currency: d.currency || '', subtotal: sub, vat, total, problems: p } }];"
      },
