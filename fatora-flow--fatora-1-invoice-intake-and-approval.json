    {
      "parameters": {
        "jsCode": "const d = $('Parse Decision').first().json; const inv = $('Find Invoice').first().json; const limit = Number($input.first().json.approval_limit_egp || 0);\nlet ok = true, toast;\nif (!d.allowed) { ok = false; toast = 'You are not an approver.'; }\nelse if (!inv.invoice_id) { ok = false; toast = 'Invoice not found.'; }\nelse if (inv.status !== 'pending_approval') { ok = false; toast = 'Already ' + inv.status + ' by ' + (inv.approved_by || '?'); }\nelse if (d.action === 'approve' && Number(inv.total) > limit && !d.is_manager) {\n  ok = false; toast = 'Above the limit: a manager must approve.'; }\nreturn [{ json: { ...d, ok, toast: ok ? (d.action === 'approve' ? 'Approved ✅' : 'Rejected ❌') : toast, status: d.action === 'approve' ? 'approved' : 'rejected' } }];"
