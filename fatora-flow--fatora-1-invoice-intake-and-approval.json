      "parameters": {
        "jsCode": "// Button data looks like fa:approve:INV-261030-AB12. Only listed people may decide.\nconst APPROVERS = ['PUT_APPROVER_USERNAME', 'PUT_MANAGER_USERNAME'];\nconst MANAGERS = ['PUT_MANAGER_USERNAME'];\nconst q = $json.callback_query; const [, action, invoice_id] = q.data.split(':');\nconst user = q.from.username || String(q.from.id);\nreturn [{ json: { action, invoice_id, user, allowed: APPROVERS.includes(user), is_manager: MANAGERS.includes(user), query_id: q.id, chat_id: q.message.chat.id, message_id: q.message.message_id, original: q.message.text } }];"
