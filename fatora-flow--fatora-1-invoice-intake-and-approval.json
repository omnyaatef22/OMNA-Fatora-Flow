      "id": "n98",
      "name": "Find Same Invoice Number",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        1792,
        128
      ],
      "alwaysOutputData": true,
      "executeOnce": true,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "// Business rules on top of the math: known vendor, no duplicates, approval level by amount.\nconst vendors = $('Read Vendors').all().map(i => i.json);\nconst same = $input.all().map(i => i.json).filter(r => r.invoice_id);\nreturn $('Validate Invoice').all().map(({ json: inv }) => {\n  const p = [...inv.problems];\n  const v = vendors.find(x => x.tax_id === inv.vendor_tax_id) || vendors.find(x => x.vendor.toLowerCase() === String(inv.vendor).toLowerCase());\n  if (!v) p.push('vendor not in the approved vendor list');\n  if (same.some(r => r.vendor_tax_id === inv.vendor_tax_id && r.invoice_number === inv.invoice_number)) p.push('DUPLICATE: this invoice number was already received from this vendor');\n  const limit = Number(v?.approval_limit_egp || 0);\n  const id = 'INV-' + $now.setZone('Africa/Cairo').toFormat('yyMMdd') + '-' + Math.random().toString(36).slice(2, 6).toUpperCase();\n  return { json: { ...inv, invoice_id: id, vendor: v?.vendor || inv.vendor, needs_manager: inv.total > limit, approval_limit: limit,\n    status: p.length ? 'needs_review' : 'pending_approval', problems: p } };\n});"
      },
