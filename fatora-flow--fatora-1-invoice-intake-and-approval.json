      "id": "n86",
      "name": "Gmail Trigger",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.4,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// An email can carry several files. Keep PDFs and images only, one item each, and remember who sent it.\nconst out = [];\nfor (const item of $input.all()) {\n  const from = item.json.from?.value?.[0]?.address || item.json.from?.text || '';\n  for (const [key, bin] of Object.entries(item.binary || {})) {\n    if (!/pdf|image\\/(jpeg|png|webp)/.test(bin.mimeType || '')) continue;\n    out.push({ json: { source: 'email', sender: from, file_name: bin.fileName || key, mime: bin.mimeType }, binary: { data: bin } });\n  }\n}\nif (!out.length) throw new Error('VALIDATION: invoice email from ' + ($input.first().json.from?.text || '?') + ' has no PDF or image attachment');\nreturn out;"
      },
      "id": "n87",
      "name": "One Item per Attachment",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ]
    },
