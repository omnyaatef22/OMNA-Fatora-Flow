y, message: msg, execution_url: e.url || '',\n  text: (severity === 'critical' ? '🚨' : '⚠️') + ' ' + (wf.name || 'Workflow') + ' · ' + type + '\\nNode: ' + (e.lastNodeExecuted || '?') + '\\n' + msg + '\\n' + (e.url || '') } }];"},"id":"n75","name":"Classify Error","type":"n8n-nodes-base.code","typeVersion":2,"position":[220,0]},{"parameters":{"authentication":"oAuth2","resource":"sheet","operation":"append","documentId":{"__rl":true,"value":"YOUR_ID","mode":"id"},"sheetName":{"__rl":true,"value":204,"mode":"id","cachedResultName":"Errors"},"columns":{"mappingMode":"defineBelow","value":{"time":"={{ $json.time }}","workflow":"={{ $json.workflow }}","node":"={{ $json.node }}","type":"={{ $json.type }}","message":"={{ $json.message }}","execution_url":"={{ $json.execution_url }}"},"matchingColumns":[],"schema":[{"id":"time","displayName":"time","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true,"removed":false},{"id":"workflow","displayName":"workflow","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true,"removed":false},{"id":"node","displayName":"node","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true,"removed":false},{"id":"type","displayName":"type","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true,"removed":false},{"id":"message","displayName":"message","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true,"removed":false},{"id":"execution_url","displayName":"execution_url","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true,"removed":false}],"attemptToConvertTypes":false,"convertFieldsToString":true},"options":{"cellFormat":"RAW","useAppend":true}},"id":"n76","name":"Log Error","type":"n8n-nodes-base.googleSheets","typeVersion":4.7,"position":[440,0],"onError":"continueRegularOutput","retryOnFail":true,"maxTries":3,"waitBetweenTries":2000},{"parameters":{"chatId":"YOUR_CHAT_ID","text":"={{ $('Classify Error').item.json.text }}","additionalFields":{"appendAttribution":false}},"id":"n77","name":"Alert Team","type":"n8n-nodes-base.telegram","typeVersion":1.2,"position":[660,0],"onError":"continueRegularOutput"},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"loose","version":3},"conditions":[{"id":"c78","leftValue":"={{ $('Classify Error').item.json.severity }}","rightValue":"critical","operator":{"type":"string","operation":"equals"}}],"combinator":"and"},"looseTypeValidation":true,"options":{}},"id":"n79","name":"Critical?","type":"n8n-nodes-base.if","typeVersion":2.3,"position":[880,0]},{"parameters":{"sendTo":"YOUR_SEND_TO","subject":"={{ 'CRITICAL: ' + $('Classify Error').item.json.workflow + ' · ' + $('Classify Error').item.json.type }}","emailType":"text","message":"={{ $('Classify Error').item.json.text }}","options":{"appendAttribution":false}},"id":"n80","name":"Email Critical Error","type":"n8n-nodes-base.gmail","typeVersion":2.2,"position":[1100,0],"onError":"continueRegularOutput"},{"parameters":{"rule":{"interval":[{"field":"cronExpression","expression":"0 9 * * 0-4"}]}},"id":"n81","name":"Every Day 09:00","type":"n8n-nodes-base.scheduleTrigger","typeVersion":1.3,"position":[0,300]},{"parameters":{"authentication":"oAuth2","resource":"sheet","operation":"read","documentId":{"__rl":true,"value":"YOUR_ID","mode":"id"},"sheetName":{"__rl":true,"value":201,"mode":"id","cachedResultName":"Invoices"},"options":{}},"id":"n82","name":"Read Invoices","type":"n8n-nodes-base.googleSheets","typeVersion":4.7,"position":[220,300],"alwaysOutputData":true,"retryOnFail":true,"maxTries":3,"waitBetweenTries":2000},{"parameters":{"jsCode":"// Morning summary for finance: what waits for approval, what is due soon, what was rejected or needs review.\nconst now = $now.setZone('Africa/Cairo');\nconst P = s => DateTime.fromISO(String(s || '').replace(' ', 'T'), { zone: 'Africa/Cairo' });\nconst inv = $input.all().map(i => i.json).filter(r => r.invoice_id);\nconst waiting = inv.filter(r => r.status === 'pending_approval' && now.diff(P(r.received_at), 'hours').hours > 24);\nconst dueSoon = inv.filter(r => r.status === 'approved' && P(r.due_date).isValid && P(r.due_date).diff(now, 'days').days <= 3);\nconst review = inv.filter(r => r.status === 'needs_review');\nconst line = r => '• ' + r.invoice_id + ' · ' + r.vendor + ' · ' + Number(r.total || 0).toLocaleString('en-US') + ' ' + (r.currency || 'EGP') + (r.due_date ? ' · due ' + r.due_date : '');\nconst sec = (t, a) => a.length ? '\\n\\n' + t + ' (' + a.length + ')\\n' + a.slice(0, 15).map(line).join('\\n') : '';\nconst body = '📊 Fatora daily digest · ' + now.toFormat('ccc dd LLL') + sec('⏳ Waiting approval > 24h', waiting) + sec('📅 Approved, due within 3 days', dueSoon) + sec('🔎 Needs review', review);\nif (!waiting.length && !dueSoon.length && !review.length) return [{ json: { text: '📊 Fatora daily digest: nothing pending. 🎉' } }];\nreturn [{ json: { text: body } }];"},"id":"n83","name":"Build Digest","type":"n8n-nodes-base.code","typeVersion":2,"position":[440,300]},{"parameters":{"chatId":"YOUR_CHAT_ID","text":"={{ $json.text }}","additionalFields":{"appendAttribution":false}},"id":"n84","name":"Post Digest","type":"n8n-nodes-base.telegram","typeVersion":1.2,"position":[660,240],"retryOnFail":true,"maxTries":3,"waitBetweenTries":2000},{"parameters":{"sendTo":"YOUR_SEND_TO","subject":"={{ 'Fatora digest ' + $now.setZone('Africa/Cairo').toFormat('yyyy-MM-dd') }}","emailType":"text","message":"={{ $json.text }}","options":{"appendAttribution":false}},"id":"n85","name":"Email Digest","type":"n8n-nodes-base.gmail","typeVersion":2.2,"position":[660,380],"onError":"continueRegularOutput","retryOnFail":true,"maxTries":3,"waitBetweenTries":2000}],"connections":{"Error Trigger":{"main":[[{"node":"Classify Error","type":"main","index":0}]]},"Classify Error":{"main":[[{"node":"Log Error","type":"main","index":0}]]},"Log Error":{"main":[[{"node":"Alert Team","type":"main","index":0}]]},"Alert Team":{"main":[[{"node":"Critical?","type":"main","index":0}]]},"Critical?":{"main":[[{"node":"Email Critical Error","type":"main","index":0}]]},"Every Day 09:00":{"main":[[{"node":"Read Invoices","type":"main","index":0}]]},"Read Invoices":{"main":[[{"node":"Build Digest","type":"main","index":0}]]},"Build Digest":{"main":[[{"node":"Post Digest","type":"main","index":0},{"node":"Email Digest","type":"main","index":0}]]}},"settings":{"executionOrder":"v1","timezone":"Africa/Cairo"}},"Fatora 1 · Invoice Intake & Approval":{"name":"Fatora 1 · Invoice Intake & Approval","nodes":[{"parameters":{"pollTimes":{"item":[{"mode":"everyX","value":5,"unit":"minutes"}]},"simple":false,"filters":{"q":"has:attachment (subject:invoice OR subject:فاتورة)"},"options":{"dataPropertyAttachmentsPrefixName":"attachment_","downloadAttachments":true}},"id":"n86","name":"Gmail Trigger","type":"n8n-nodes-base.gmailTrigger","typeVersion":1.4,"position":[0,0]},{"parameters":{"jsCode":"// An email can carry several files. Keep PDFs and images only, one item each, and remember who sent it.\nconst out = [];\nfor (const item of $input.all()) {\n  const from = item.json.from?.value?.[0]?.address || item.json.from?.text || '';\n  for (const [key, bin] of Object.entries(item.binary || {})) {\n    if (!/pdf|image\\/(jpeg|png|webp)/.test(bin.mimeType || '')) continue;\n    out.push({ json: { source: 'email', sender: from, file_name: bin.fileName || key, mime: bin.mimeType }, binary: { data: bin } });\n  }\n}\nif (!out.length) throw new Error('VALIDATION: invoice email from ' + ($input.first().json.from?.text || '?') + ' has no PDF or image attachment');\nreturn out;"},"id":"n87","name":"One Item per Attachment","type":"n8n-nodes-base.code","typeVersion":2,"position":[224,0]},{"parameters":{"updates":["message","callback_query"],"additionalFields":{}},"id":"n88","name":"Telegram Trigger","type":"n8n-nodes-base.telegramTrigger","typeVersion":1.3,"position":[0,352]},{"parameters":{"rules":{"values":[{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"loose","version":3},"conditions":[{"id":"c89","leftValue":"={{ $json.callback_query?.data }}","rightValue":"fa:","operator":{"type":"string","operation":"startsWith"}}],"combinator":"and"},"renameOutput":true,"outputKey":"Decision"},{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"loose","version":3},"conditions":[{"id":"c90","leftValue":"={{ $json.message?.document?.file_id || ($json.message?.photo || []).at(-1)?.file_id || '' }}","rightValue":"","operator":{"type":"string","operation":"notEmpty","singleValue":true}}],"combinator":"and"},"renameOutput":true,"outputKey":"File"}]},"looseTypeValidation":true,"options":{}},"id":"n91","name":"Route Update","type":"n8n-nodes-base.switch","typeVersion":3.4,"position":[224,352]},{"parameters":{"resource":"file","fileId":"={{ $json.message.document?.file_id || $json.message.photo.at(-1).file_id }}","additionalFields":{}},"id":"n92","name":"Download Telegram File","type":"n8n-nodes-base.telegram","typeVersion":1.2,"position":[448,464],"retryOnFail":true,"maxTries":3,"waitBetweenTries":2000},{"parameters":{"jsCode":"const m = $('Route Update').item.json.message;\nconst bin = $input.first().binary.data;\nreturn [{ json: { source: 'telegram', sender: (m.from.username ? '@' + m.from.username : m.from.first_name), chat_id: m.chat.id, file_name: bin.fileName || 'photo.jpg', mime: m.document?.mime_type || bin.mimeType || 'image/jpeg' }, binary: { data: bin } }];"},"id":"n93","name":"Tag Telegram File","type":"n8n-nodes-base.code","typeVersion":2,"position":[672,464]},{"parameters":{"jsCode":"// Send the file itself (PDF or photo) to Gemini as base64, with a strict JSON contract.\nconst out = [];\nfor (const [i, item] of $input.all().entries()) {\n  const buf = await this.helpers.getBinaryDataBuffer(i, 'data');\n  if (buf.length > 15 * 1024 * 1024) throw new Error('VALIDATION: file ' + item.json.file_name + ' is larger than 15 MB');\n  out.push({ json: { ...item.json, b64: buf.toString('base64'),\n    prompt: 'You read Egyptian supplier invoices (Arabic or English). Return JSON only with keys: vendor, vendor_tax_id, invoice_number, invoice_date (YYYY-MM-DD), due_date (YYYY-MM-DD or \"\"), currency (EGP|USD|EUR), items: [{description, quantity, unit_price, line_total}], subtotal, vat, total, readable (true|false). Numbers without separators. If a value is not printed on the document use \"\" — never guess.' } });\n}\nreturn out;"},"id":"n94","name":"Prepare Extraction","type":"n8n-nodes-base.code","typeVersion":2,"position":[912,208]},{"parameters":{"method":"POST","url":"https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent","authentication":"predefinedCredentialType","nodeCredentialType":"googlePalmApi","sendBody":true,"specifyBody":"json","jsonBody":"={{ JSON.stringify({ contents: [{ parts: [{ text: $json.prompt }].concat($json.b64 ? [{ inline_data: { mime_type: $json.mime, data: $json.b64 } }] : []) }], generationConfig: { responseMimeType: 'application/json', temperature: 0.1 } }) }}","options":{"timeout":60000}},"id":"n95","name":"AI Read Invoice","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[1120,208],"retryOnFail":true,"maxTries":3,"waitBetweenTries":2000},{"parameters":{"jsCode":"// The AI reads; code checks. Every rule that fails becomes a readable problem.\nconst src = $('Prepare Extraction').item.json;\nlet d; try { d = JSON.parse(($json.candidates?.[0]?.content?.parts || []).map(p => p.text).join('')); } catch (e) { d = null; }\nconst p = []; const num = v => Number(String(v ?? '').replace(/[^0-9.\\-]/g, ''));\nif (!d || d.readable === false) p.push('document unreadable: send a clearer photo or the original PDF');\nd = d || {};\nconst items = Array.isArray(d.items) ? d.items : [];\nconst sumLines = items.reduce((s, it) => s + num(it.line_total), 0);\nitems.forEach((it, k) => { if (Math.abs(num(it.quantity) * num(it.unit_price) - num(it.line_total)) > 1) p.push('line ' + (k + 1) + ': quantity × price ≠ line total'); });\nconst sub = num(d.subtotal), vat = num(d.vat), total = num(d.total);\nif (!total) p.push('total missing');\nif (items.length && Math.abs(sumLines - sub) > 1) p.push('lines add up to ' + sumLines + ' but subtotal says ' + sub);\nif (sub && Math.abs(sub * 0.14 - vat) > Math.max(1, sub * 0.002)) p.push('VAT ' + vat + ' is not 14% of ' + sub);\nif (sub && Math.abs(sub + vat - total) > 1) p.push('subtotal + VAT ≠ total');\nif (!/^\\d{3}-?\\d{3}-?\\d{3}$/.test(String(d.vendor_tax_id || ''))) p.push('tax registration number missing or not 9 digits');\nif (!d.invoice_number) p.push('invoice number missing');\nconst today = $now.setZone('Africa/Cairo').toFormat('yyyy-MM-dd');\nif (!/^\\d{4}-\\d{2}-\\d{2}$/.test(d.invoice_date || '') || d.invoice_date > today) p.push('invoice date missing or in the future');\nif (d.due_date && d.due_date < today) p.push('due date already passed');\nif (!['EGP', 'USD', 'EUR'].includes(d.currency)) p.push('currency not recognised');\nconst tax = String(d.vendor_tax_id || '').replace(/\\D/g, '').replace(/(\\d{3})(\\d{3})(\\d{3})/, '$1-$2-$3');\nreturn [{ json: { ...src, b64: undefined, vendor: d.vendor || '', vendor_tax_id: tax, invoice_number: String(d.invoice_number || ''), invoice_date: d.invoice_date || '', due_date: d.due_date || '',\n  currency: d.currency || '', subtotal: sub, vat, total, problems: p } }];"},"id":"n96","name":"Validate Invoice","type":"n8n-nodes-base.code","typeVersion":2,"position":[1344,208]},{"parameters":{"documentId":{"__rl":true,"value":"YOUR_ID","mode":"id"},"sheetName":{"__rl":true,"value":202,"mode":"id","cachedResultName":"Vendors"},"options":{}},"id":"n97","name":"Read Vendors","type":"n8n-nodes-base.googleSheets","typeVersion":4.7,"position":[1568,128],"executeOnce":true,"retryOnFail":true,"